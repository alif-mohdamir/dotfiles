#!/bin/bash
# ce-sync: keep a checkout's compound-engineering learnings and plans (.ce/solutions, .ce/plans) in a private
# store, out of the repo's history, in step across machines.
#
#   ce-sync pull         sync the checkout around the current directory with the store
#   ce-sync push         the same
#   ce-sync hook-start   sync, for a Claude SessionStart hook
#   ce-sync hook-stop    sync if anything changed locally, for Claude Stop and SessionEnd hooks
#
# The store is whatever commands in ~/.config/ce-sync/config say, with %r for the repo name, %d for a
# directory to download into, %f for a local file and %p for its path within the repo's folder. Without
# that file every subcommand does nothing.
#
#   CE_SYNC_PULL='store-cli get learnings:%r/ %d -r'   download the repo's folder into %d
#   CE_SYNC_PUT='store-cli put %f learnings:%r/%p'     upload one file
#   CE_SYNC_RM='store-cli rm learnings:%r/%p'          delete one file
#   CE_SYNC_HOST=laptop                                names this machine's conflict copies (default: hostname)
#
# A file changed on one side since the last sync takes that side's version on both. When both sides
# changed it, the store's version keeps the name and this machine's is kept beside it as
# <name>.conflict-<host>.<ext>. A delete reaches the other side unless the file was edited there.
set -uo pipefail

CONFIG=${CE_SYNC_CONFIG:-~/.config/ce-sync/config}
CE_DIR=.ce
CE_CONFIG=.compound-engineering/config.yaml
SYNCED="solutions plans"
# Never deleted, so a download that lacks it means the store was unreachable rather than emptied
MARKER=.ce-sync

[[ -r $CONFIG ]] || exit 0
# shellcheck source=/dev/null
source "$CONFIG"
[[ -n ${CE_SYNC_PULL:-} ]] || exit 0

notices=()
warn() { notices+=("$*"); }

resolve() {
	root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
	# A repo that commits its own CE config has chosen where its artifacts go
	git -C "$root" ls-files --error-unmatch "$CE_CONFIG" >/dev/null 2>&1 && return 1
	if [[ -f $root/$CE_CONFIG ]] && ! grep -qx "docs_root: $CE_DIR" "$root/$CE_CONFIG"; then
		return 1
	fi
	local url gitdir
	url=$(git -C "$root" remote get-url origin 2>/dev/null) || url=$root
	repo=$(basename "${url%/}" .git)
	dir=$root/$CE_DIR
	# Per worktree, and outside .ce/ so it is never synced
	gitdir=$(git -C "$root" rev-parse --absolute-git-dir)
	record=$gitdir/ce-sync-record
	lock=$gitdir/ce-sync.lock
}

init() {
	mkdir -p "$dir" "$root/${CE_CONFIG%/*}"
	[[ -f $root/$CE_CONFIG ]] || echo "docs_root: $CE_DIR" >"$root/$CE_CONFIG"
	# The common dir's exclude covers every worktree of the clone
	local exclude
	exclude=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/info/exclude
	mkdir -p "${exclude%/*}"
	touch "$exclude"
	for p in "/$CE_DIR/" "/${CE_CONFIG%/*}/"; do
		grep -qxF "$p" "$exclude" || echo "$p" >>"$exclude"
	done
}

tracked() { git -C "$root" ls-files -z -- "$CE_DIR/solutions" "$CE_DIR/plans" | tr '\0' '\n' | sed "s|^$CE_DIR/||"; }

# $2 lists paths to leave out
listing() {
	local d dirs=()
	for d in $SYNCED; do [[ -d $1/$d ]] && dirs+=("$d"); done
	((${#dirs[@]})) || return 0
	(cd "$1" && find "${dirs[@]}" -type f -exec cksum {} +) |
		awk -v skip="${2:-/dev/null}" '
			BEGIN { while ((getline t < skip) > 0) left_out[t] }
			{ p = $0; sub(/^[^ ]+ [^ ]+ /, "", p); if (!(p in left_out)) print $1 "-" $2 " " p }' |
		LC_ALL=C sort -k2
}

lookup() { awk -v p="$2" 'substr($0, index($0, " ") + 1) == p { print $1; exit }' "$1"; }

run() {
	local cmd=$1 q
	printf -v q %q "$repo" && cmd=${cmd//%r/$q}
	printf -v q %q "${2:-}" && cmd=${cmd//%d/$q}
	printf -v q %q "${3:-}" && cmd=${cmd//%f/$q}
	printf -v q %q "${4:-}" && cmd=${cmd//%p/$q}
	bash -c "$cmd" >/dev/null 2>&1
}

put() { run "$CE_SYNC_PUT" "" "$1" "$2"; }

conflict_name() {
	local base=${1%.*} ext=${1##*.} host=${CE_SYNC_HOST:-$(hostname -s)}
	if [[ $base == "$1" || $base == */ ]]; then
		echo "$1.conflict-$host"
	else
		echo "$base.conflict-$host.$ext"
	fi
}

download() {
	snap=$work/snap
	rm -rf "$snap" && mkdir -p "$snap"
	run "$CE_SYNC_PULL" "$snap" && [[ -f $snap/$MARKER ]] && return 0
	if [[ -s $record ]]; then
		warn "the store's folder for $repo was unreachable; changed nothing"
		return 1
	fi
	setup_new_folder
}

# With no record yet, a missing marker may only mean the repo's folder is new
setup_new_folder() {
	echo "ce-sync marker: keep this file" >"$work/marker"
	put "$work/marker" "$MARKER" || { warn "could not reach the store for $repo"; return 1; }
	rm -rf "$snap" && mkdir -p "$snap"
	run "$CE_SYNC_PULL" "$snap" && [[ -f $snap/$MARKER ]] && return 0
	warn "the store's folder for $repo did not come back after setup; changed nothing"
	return 1
}

take() {
	mkdir -p "$(dirname "$dir/$2")" && cp "$1" "$dir/$2"
}

reconcile() {
	local p local_sum store_sum base_sum new_base copy n
	touch "$record"
	tracked >"$work/tracked"
	listing "$dir" "$work/tracked" >"$work/local"
	listing "$snap" "$work/tracked" >"$work/store"
	: >"$work/record"
	: >"$work/notices"
	cut -d' ' -f2- "$work/local" "$work/store" "$record" | LC_ALL=C sort -u | while IFS= read -r p; do
		local_sum=$(lookup "$work/local" "$p")
		store_sum=$(lookup "$work/store" "$p")
		base_sum=$(lookup "$record" "$p")
		new_base=
		if [[ $local_sum == "$store_sum" ]]; then
			new_base=$local_sum
		elif [[ $local_sum == "$base_sum" ]]; then
			if [[ -z $store_sum ]]; then
				rm -f "$dir/$p"
			else
				take "$snap/$p" "$p" && new_base=$store_sum || new_base=$base_sum
			fi
		elif [[ $store_sum == "$base_sum" ]]; then
			if [[ -z $local_sum ]]; then
				run "$CE_SYNC_RM" "" "" "$p" || new_base=$base_sum
			else
				put "$dir/$p" "$p" && new_base=$local_sum || new_base=$base_sum
			fi
		elif [[ -z $local_sum ]]; then
			take "$snap/$p" "$p" && new_base=$store_sum || new_base=$base_sum
			echo "kept $p: it was deleted here but edited elsewhere" >>"$work/notices"
		elif [[ -z $store_sum ]]; then
			put "$dir/$p" "$p" && new_base=$local_sum || new_base=$base_sum
			echo "kept $p: it was edited here but deleted elsewhere" >>"$work/notices"
		else
			copy=$(conflict_name "$p")
			if cp "$dir/$p" "$dir/$copy" && put "$dir/$copy" "$copy" && take "$snap/$p" "$p"; then
				new_base=$store_sum
				echo "$local_sum $copy" >>"$work/record"
				echo "$p changed here and elsewhere: merge $copy into it" >>"$work/notices"
			else
				new_base=$base_sum
			fi
		fi
		[[ -n $new_base ]] && echo "$new_base $p" >>"$work/record"
	done
	LC_ALL=C sort -k2 "$work/record" >"$record.tmp" && mv "$record.tmp" "$record"
	while IFS= read -r n; do warn "$n"; done <"$work/notices"
}

# mkdir is atomic on macOS and Linux, and macOS has no flock. Another session holding the lock is
# syncing the same worktree, so skipping loses nothing; a lock older than 10 minutes was left by a crash.
acquire() {
	mkdir "$lock" 2>/dev/null && return 0
	[[ -n $(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null) ]] || return 1
	rmdir "$lock" 2>/dev/null
	mkdir "$lock" 2>/dev/null
}

sync() {
	if [[ -z ${CE_SYNC_PUT:-} || -z ${CE_SYNC_RM:-} ]]; then
		warn "$CONFIG needs CE_SYNC_PUT and CE_SYNC_RM; nothing synced"
		return 1
	fi
	acquire || return 0
	work=$(mktemp -d)
	trap 'rm -rf "$work"; rmdir "$lock" 2>/dev/null' EXIT
	download && reconcile
}

report() {
	local n
	for n in "${notices[@]+"${notices[@]}"}"; do echo "ce-sync: $n" >&2; done
}

# A hook's JSON systemMessage is shown to the user and kept out of Claude's context
report_hook() {
	((${#notices[@]})) || return 0
	local msg n
	msg="ce-sync: ${notices[0]}"
	for n in "${notices[@]:1}"; do msg+="; $n"; done
	if command -v jq >/dev/null; then
		jq -cn --arg m "$msg" '{systemMessage: $m}'
	else
		msg=${msg//\\/\\\\}
		printf '{"systemMessage":"%s"}\n' "${msg//\"/\\\"}"
	fi
}

hook_cwd() {
	local cwd
	cwd=$(jq -r '.cwd // empty' 2>/dev/null)
	echo "${cwd:-$PWD}"
}

case ${1:-} in
pull | push)
	resolve "$PWD" || { echo "ce-sync: not a checkout ce-sync manages" >&2; exit 1; }
	init
	sync
	report
	;;
hook-start)
	resolve "$(hook_cwd)" || exit 0
	init
	sync
	report_hook
	exit 0
	;;
hook-stop)
	resolve "$(hook_cwd)" || exit 0
	[[ -d $dir ]] || exit 0
	# hook-start already warned this session about an old config
	[[ -n ${CE_SYNC_PUT:-} && -n ${CE_SYNC_RM:-} ]] || exit 0
	# Stop fires after every reply, so a reply that changed nothing here makes no network call
	[[ $(listing "$dir" <(tracked)) == "$(cat "$record" 2>/dev/null)" ]] && exit 0
	sync
	report_hook
	exit 0
	;;
*)
	echo "usage: ce-sync pull|push|hook-start|hook-stop" >&2
	exit 2
	;;
esac
