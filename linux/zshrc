export EDITOR=nvim VISUAL=nvim
export PATH="$HOME/.local/bin:$HOME/scripts:$PATH"
# Dev boxes clone repos into ~/src
export LOCAL_WORKSPACES="$HOME/src $HOME/projects"
repo-jump() {
	# Over ssh outside tmux, a tmux session would nest inside the client's tmux, so cd in place instead
	if [[ -z $SSH_CONNECTION || -n $TMUX ]]; then
		BUFFER=tmux-sessionizer
		zle accept-line
		return
	fi
	local dir
	dir=$(find ${=LOCAL_WORKSPACES} -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf) || {
		zle reset-prompt
		return
	}
	# Run as a typed command so the prompt and title hooks see the new directory
	BUFFER="cd ${(q)dir}"
	zle accept-line
}
zle -N repo-jump
bindkey '^f' repo-jump
